<?xml version="1.0" encoding="UTF-8"?>
<wfs:WFS_Capabilities version="2.0.0"
    xmlns:wfs="http://www.opengis.net/wfs/2.0"
    xmlns:ows="http://www.opengis.net/ows/1.1"
    xmlns:fes="http://www.opengis.net/fes/2.0"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/wfs/2.0 http://schemas.opengis.net/wfs/2.0/wfs.xsd">
  <ows:ServiceIdentification>
    <ows:Title>Servicio WFS de Geotensores Vectoriales (IDE Chile / SNIT)</ows:Title>
    <ows:Abstract>Servicio de Entidades Web (WFS 2.0) de Puerto Umbral. Entrega capas vectoriales completas en GeoJSON y GML de la Base Ontologica de la RMS.</ows:Abstract>
    <ows:Keywords>
      <ows:Keyword>IDE Chile</ows:Keyword>
      <ows:Keyword>SNIT</Keyword>
      <ows:Keyword>WFS</ows:Keyword>
      <ows:Keyword>GeoJSON</ows:Keyword>
      <ows:Keyword>Geotensores</ows:Keyword>
    </ows:Keywords>
    <ows:ServiceType>WFS</ows:ServiceType>
    <ows:ServiceTypeVersion>2.0.0</ows:ServiceTypeVersion>
    <ows:Fees>NONE</ows:Fees>
    <ows:AccessConstraints>Open Access CARE/FAIR</ows:AccessConstraints>
  </ows:ServiceIdentification>
  <ows:OperationsMetadata>
    <ows:Operation name="GetCapabilities">
      <ows:DCP><ows:HTTP><ows:Get xlink:href="https://ontologiaterritorial.github.io/puerto_umbral/ogc/wfs"/></ows:HTTP></ows:DCP>
    </ows:Operation>
    <ows:Operation name="GetFeature">
      <ows:DCP><ows:HTTP><ows:Get xlink:href="https://ontologiaterritorial.github.io/puerto_umbral/ogc/wfs"/></ows:HTTP></ows:DCP>
    </ows:Operation>
  </ows:OperationsMetadata>
  <wfs:FeatureTypeList>
    <wfs:FeatureType>
      <wfs:Name>puerto_umbral:einstein_rings</wfs:Name>
      <wfs:Title>Anillos de Einstein y Lentes Gravitacionales RMS</wfs:Title>
      <wfs:DefaultCRS>urn:ogc:def:crs:EPSG::4326</wfs:DefaultCRS>
      <wfs:OtherCRS>urn:ogc:def:crs:EPSG::4674</wfs:OtherCRS>
      <wfs:OtherCRS>urn:ogc:def:crs:EPSG::32719</wfs:OtherCRS>
      <wfs:OutputFormats>
        <wfs:Format>application/json</wfs:Format>
        <wfs:Format>text/xml; subtype=gml/3.2</wfs:Format>
      </wfs:OutputFormats>
    </wfs:FeatureType>
    <wfs:FeatureType>
      <wfs:Name>puerto_umbral:hotspots_latencia</wfs:Name>
      <wfs:Title>Hotspots de Latencia Territorial (Duelo No Resuelto)</wfs:Title>
      <wfs:DefaultCRS>urn:ogc:def:crs:EPSG::4326</wfs:DefaultCRS>
      <wfs:OtherCRS>urn:ogc:def:crs:EPSG::4674</wfs:OtherCRS>
      <wfs:OtherCRS>urn:ogc:def:crs:EPSG::32719</wfs:OtherCRS>
      <wfs:OutputFormats>
        <wfs:Format>application/json</wfs:Format>
        <wfs:Format>text/xml; subtype=gml/3.2</wfs:Format>
      </wfs:OutputFormats>
    </wfs:FeatureType>
  </wfs:FeatureTypeList>
</wfs:WFS_Capabilities>
